{
  "name": "a-republica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.8",
  "scripts": {
    "dev:backend": "pnpm --filter @a-republica/backend dev",
