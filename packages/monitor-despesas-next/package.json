{
  "name": "features-republica",
  "version": "0.1.0",
  "description": "Sistema de monitoramento e análise de gastos de deputados federais brasileiros",
  "author": "A República",
  "private": true,
  "scripts": {
    "cache:publish": "tsc --project scripts/tsconfig.publish.json && node scripts/dist/publish_cache.js",
    "cache:publish:dry-run": "tsc --project scripts/tsconfig.publish.json && node scripts/dist/publish_cache.js -- --dry-run",
    "cache:publish:build": "tsc --project scripts/tsconfig.publish.json",
    "cache:manifests:refresh": "tsc --project scripts/tsconfig.publish.json && node scripts/dist/refresh_cache_manifests.js",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "cross-env USE_LOCAL_ETL=true next build --turbopack",
    "build:webpack": "cross-env USE_LOCAL_ETL=true next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@a-republica/shared": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "import-in-the-middle": "^2.0.0",
    "lucide-react": "^0.552.0",
    "next": "16.0.1",
    "react": "19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4",
    "require-in-the-middle": "^8.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.19.23",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.0.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.1",
    "playwright": "^1.48.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}