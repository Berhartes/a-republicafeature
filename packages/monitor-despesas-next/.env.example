NEXT_PUBLIC_SITE_URL=http://localhost:3000
CACHE_CDN_BASE=https://berhartes.github.io/a-republica-brasileira-caches/latest
NEXT_PUBLIC_LOG_LEVEL=info
DEFAULT_REVALIDATE=3600
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=monitor-despesas-next
USE_BACKUP_CACHE=false
USE_TEST_CACHE=false
# Existing entries...

# Base da CDN pública para caches (fallback quando ETL/test/backup não estão disponíveis)
CACHE_CDN_BASE="https://berhartes.github.io/a-republica-brasileira-caches/latest"

# Habilita leitura local de test-cache-output
USE_TEST_CACHE="false"

# Habilita leitura de backup local (inclui .br/.gz)
USE_BACKUP_CACHE="false"

# Tamanho máximo por entrada em MB para armazenar em memória
CACHE_MAX_ENTRY_MB="8"

# Token opcional para proteger a rota de invalidation em produção
CACHE_INVALIDATION_TOKEN=""

# Diretório externo do ETL com caches locais (prioritário)
# Defina para um caminho fora do app Next, por ex.:
# ETL_OUTPUT_DIR=C:/data/etl/cache
# ou para o diretório de testes do monorepo:
# ETL_OUTPUT_DIR=../test-cache-output
ETL_OUTPUT_DIR=
