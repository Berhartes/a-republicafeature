{
  "version": 2,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "env": {
    "NEXT_PUBLIC_CACHE_BASE_URL": "/cache",
    "NEXT_PUBLIC_USE_LOCAL_CACHE": "true"
  },
  "headers": [
    {
      "source": "/cache/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}

